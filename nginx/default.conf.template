# Rendered at image build time by scripts/render-nginx.sh, which fills the
# __RPC_*__ placeholders from the RPC_URL build arg.
server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # TLS terminates at the ALB and nginx listens on 8080, so an absolute
    # Location built from the request scheme + listen port would be
    # http://squads.asymmetric.re:8080/... — emit relative redirects instead.
    absolute_redirect off;

    location / {
        try_files $uri $uri/ =404;
    }

    # Server-level add_header only applies to locations that set none of their
    # own, so keep every header here and add none inside location blocks.
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Complements the <meta> CSP SvelteKit writes into index.html (see
    # svelte.config.js); both apply. No default-src or script-src here: the
    # meta policy allows SvelteKit's inline bootstrap by hash, and a header
    # script-src would block it. This adds what a meta CSP can't express
    # (frame-ancestors) and narrows connects to this origin, the Squads API and
    # the RPC endpoint. The style hash is SvelteKit's screen-reader announcer
    # (inline style="position: absolute; ... height: 1px" in
    # @sveltejs/kit/src/core/sync/write_root.js); if a Kit upgrade changes it,
    # the browser console names the new hash.
    add_header Content-Security-Policy "upgrade-insecure-requests; frame-src 'self'; style-src 'self' 'unsafe-hashes' 'sha256-S8qMpvofolR8Mpjy4kQvEm7m1q8clzU4dfDH0AmvZjo='; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; connect-src 'self' https://squads.asymmetric.re https://v4-api.squads.so __RPC_ORIGIN__ __RPC_WS_ORIGIN__" always;
}
