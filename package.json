{
	"name": "squads.asymmetric.re",
	"version": "1.0.0",
	"description": "Minimal multisig transaction verifier for Squads Protocol v4",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:hash": "bash scripts/build.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"format": "biome check --write .",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^26",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6",
		"vite": "^8.0.7",
		"vitest": "^5"
	}
}
